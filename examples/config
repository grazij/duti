# Install as $XDG_CONFIG_HOME/duti/config, ~/.config/duti/config or
# ~/.duti/config and run `duti`, or use `duti -c path/to/config`.
#
#   <bundle id>  <url scheme>
#   <bundle id>  <uti | .ext | mime/type>  <role>
#
# Roles: all, viewer, editor (implies viewer), shell, none (icon only).
# Bundle ids: osascript -e 'id of app "Safari"'

# --- web ---
com.apple.Safari	public.html	all
com.apple.Safari	http
com.apple.Safari	https

# --- plain text and source code ---
com.apple.TextEdit	public.plain-text	all
com.apple.TextEdit	public.source-code	all

# --- images ---
com.apple.Preview	public.jpeg	all
com.apple.Preview	public.png	all

# --- documents ---
com.apple.Preview	com.adobe.pdf	all
